{
  "name": "snakes-ladders",
  "private": true,
  "version": "0.1.0",
  "description": "A 2D Snakes & Ladders game for 2-4 players",
  "author": "Amith Haridas",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "app": "npm run build && electron electron/main.cjs",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-singlefile": "^2.0.2",
    "vitest": "^1.6.0"
  }
}
